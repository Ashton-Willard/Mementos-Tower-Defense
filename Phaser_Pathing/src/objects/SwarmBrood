import Enemy from './Enemy.js';

export default class SwarmBrood extends Enemy {
    constructor(scene) {
        super(scene);

        this.setTexture('swarm_brood');

        this.speed = 0.00003 * 1.3;
        this.maxHp = 40;
        this.hp = 40;

        this.reward = 2;
        this.leakDamage = 0.5;

        this.healthbar.update();
    }
}
