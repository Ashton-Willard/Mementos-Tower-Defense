import Enemy from './Enemy.js';

export default class SnowCrawler extends Enemy {
    constructor(scene) {
        super(scene);

        this.setTexture('snow_crawler');

        this.speed = 0.00003 * 0.8;
        this.maxHp = 350;
        this.hp = 350;

        this.reward = 9;
        this.leakDamage = 2;

        this.healthbar.update();
    }
}
